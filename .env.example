# 应用密钥：生产环境请改成随机字符串，至少 32 字节
SECRET_KEY=your-secret-key-change-in-production

# JWT 算法
ALGORITHM=HS256

# Token 过期时间（分钟），默认 7 天
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# 是否启用开发测试账号（默认 true，生产环境建议设为 false 避免重置账号）
ENABLE_DEV_TEST_USER=true

# Apple Sign In 的 Bundle ID
APPLE_CLIENT_ID=

# Tushare Pro Token（股票数据源）
# 从 https://tushare.pro/register.html 注册获取
TUSHARE_TOKEN=

# Tushare 代理地址（高积分代理，用于分时等高级接口）
TUSHARE_PROXY_URL=
TUSHARE_PROXY_TOKEN=

# SMTP 邮件发送（验证码）
# QQ 邮箱服务器为 smtp.qq.com，端口 465，密码填授权码
SMTP_SERVER=smtp.qq.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=
SMTP_USE_SSL=true

# PostgreSQL 数据库连接（Docker 内使用服务名 postgres）
# 本地开发示例：postgresql+psycopg2://yingplus_user:yingplus_password@127.0.0.1:5432/yingplus
DATABASE_URL=postgresql+psycopg2://yingplus_user:yingplus_password@127.0.0.1:5432/yingplus

# Redis 缓存（可选，未配置时自动降级为内存缓存）
# Docker 内使用服务名 redis：redis://redis:6379/0
REDIS_URL=redis://127.0.0.1:6379/0

# PostgreSQL Docker 容器配置（仅用于 docker-compose.yml）
POSTGRES_USER=yingplus_user
POSTGRES_PASSWORD=yingplus_password
POSTGRES_DB=yingplus

# 开发环境是否使用 mock 股票数据（无 Tushare token 时方便调试）
MOCK_STOCK_DATA=false

# 阿里云 OSS（文件存储，私有读写，需签名 URL 访问）
# 用于用户头像、图片等文件上传
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=ying-trade
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_CUSTOM_DOMAIN=
OSS_SIGN_EXPIRE=3600

# AI 模型配置
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
